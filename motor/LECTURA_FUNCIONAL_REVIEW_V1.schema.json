{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "package_sha256", "contract_sha256",
    "input_sha256", "result_sha256", "artifact_sha256", "producer",
    "reviewer", "review_basis", "decision", "checks", "evidence_map",
    "unmet_requirements", "critical_flags", "summary"
  ],
  "properties": {
    "schema_version": {"const": "FUNCTIONAL_REVIEW_V1"},
    "case_id": {"type": "string", "minLength": 1},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "run_id", "role"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "role": {"const": "producer"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "run_id", "role", "independent_attested"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "role": {"const": "independent_reviewer"},
        "independent_attested": {"const": true}
      }
    },
    "review_basis": {"const": "contract_and_final_artifact_without_producer_self_review"},
    "decision": {"enum": ["PASS", "FAIL", "INDETERMINATE"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_refs", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "relation", "note"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "relation": {"enum": ["supports", "contradicts", "limits"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "unmet_requirements": {"type": "array", "items": {"type": "string"}},
    "critical_flags": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string", "minLength": 1}
  }
}