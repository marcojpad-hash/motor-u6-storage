    },
    {
      "id": "src2",
      "texto": "The Mozart Portal timeline: primeras composiciones K.1a/K.1b en 1761; primer viaje a Múnich en 1762 y actuaciones en Viena.",
      "origen": "https://www.mozartportal.com/es/timeline"
    },
    {
      "id": "src3",
      "texto": "Fundación Mozarteum del Uruguay: nombramiento como Konzertmeister en 1769; viajes a Italia 1769–1771; retorno a Salzburgo en 1771 y actividad compositiva posterior.",
      "origen": "https://www.mozarteumuruguay.org/bio.php"
    },
    {
      "id": "src4",
      "texto": "Fundación Mozarteum del Uruguay: viaje con su madre en 1777, estancia en París y muerte de Anna Maria en 1778; regreso a Salzburgo en 1779 y puesto de organista de corte.",
      "origen": "https://www.mozarteumuruguay.org/bio.php"
    },
    {
      "id": "src5",
      "texto": "Fundación Mozarteum del Uruguay: en 1781 termina la relación laboral con el príncipe-arzobispo y Mozart decide establecerse en Viena; se casa con Constanze en 1782.",
      "origen": "https://www.mozarteumuruguay.org/bio.php"
    },
    {
      "id": "src6",
      "texto": "Mozart Documents: documentos de conciertos y actividad pública en Viena en 1786; el informe de 7 de abril identifica una academia de Mozart en el Kärntnertortheater. Solo se usan hechos hasta 1786.",
      "origen": "https://www.mozartdocuments.org/documents/7-april-1786/"
    },
    {
      "id": "src7",
      "texto": "Mozart Documents: informe fechado el 7 de mayo de 1786 sobre el estreno de Le nozze di Figaro la noche del 1 de mayo de 1786.",
      "origen": "https://www.mozartdocuments.org/documents/7-may-1786/"
    }
