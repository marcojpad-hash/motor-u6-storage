 "caldero_search_sources": [
  {
   "id": "src1",
   "texto": "Napoleón Bonaparte: nace en Ajaccio el 15-ago-1769; ingresa en Brienne en 1779; se gradúa en la École Militaire y es nombrado teniente segundo de artillería en 1785.",
   "origen": "https://es.wikipedia.org/wiki/Napole%C3%B3n_Bonaparte"
  },
  {
   "id": "src2",
   "texto": "Tolón (19-dic-1793): Napoleón dirige la artillería que recupera el puerto; asciende a general de brigada. Campaña de Italia (1796): victorias de Montenotte y Lodi; reconocimiento en toda Francia.",
   "origen": "https://es.wikipedia.org/wiki/Napole%C3%B3n_Bonaparte"
  },
  {
   "id": "src3",
   "texto": "18 Brumario (9-nov-1799): golpe de Estado; Primer Cónsul. Coronación como emperador (2-dic-1804). Austerlitz (2-dic-1805). Tilsit (7-jul-1807): apogeo del poder en Europa.",
   "origen": "https://es.wikipedia.org/wiki/Napole%C3%B3n_Bonaparte"
  },
  {
   "id": "src4",
   "texto": "Invasión de Rusia (24-jun-1812): cruza el Niemen con la Grande Armée. Waterloo (18-jun-1815): derrota definitiva. Exilio a Santa Elena (oct-1815), donde escribe sus memorias.",
   "origen": "https://es.wikipedia.org/wiki/Napole%C3%B3n_Bonaparte"
  }
 ],
